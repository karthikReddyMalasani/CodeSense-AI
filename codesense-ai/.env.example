# ============================================================
# CodeSense AI — Environment Variables Example
# ============================================================

# ─── AI Provider: Google Gemini ──────────────────────────────
AI_LLM_PROVIDER=gemini
AI_EMBEDDING_PROVIDER=mock
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_DIMENSION=768

# ─── Database: PostgreSQL / PGVector ──────────────────────────
DATABASE_URL=jdbc:postgresql://your-db-host:5432/your_database?sslmode=require
DATABASE_USERNAME=your_db_user
DATABASE_PASSWORD=your_db_password

# ─── JWT Secret ──────────────────────────────────────────────
JWT_SECRET=your_base64_encoded_64_character_secret_key_here
JWT_EXPIRATION_MS=86400000

# ─── GitHub Access Token (Optional for Private Repos) ───────
GITHUB_ACCESS_TOKEN=

# ─── Storage Configuration ──────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=100

# ─── Spring Profile ──────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev
